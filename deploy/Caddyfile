# /etc/caddy/Caddyfile
# Replace infall.example.org with your domain. Caddy gets and renews the HTTPS
# certificate by itself; ports 80 and 443 must be reachable for that.
infall.example.org {
	# WebSockets (live updates) work through reverse_proxy with no extra
	# settings; the Origin header is passed through for the server's own check.
	reverse_proxy 127.0.0.1:8787

	encode zstd gzip

	# Browsers will refuse plain HTTP for this domain for a year.
	# Do not add "preload" unless you understand what it commits you to.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Refuse oversized request bodies here, before they reach the server.
	# These are the server's own limits: 8192 MiB for a Workspace file brought
	# onto an empty server (INFALL_MAX_IMPORT_MB), 100 MiB for a PDF
	# (INFALL_MAX_PDF_MB) — change each in both places together — 20 MiB for a
	# PDF's text, 2 MiB on the one route that carries the captured result of a
	# Run, 1 MiB everywhere else. Keep them equal to the server's: a smaller
	# limit here would refuse what the server accepts. (Write "MiB": Caddy's
	# "MB" is 1000-based and a little smaller.)
	@import path /api/workspace/import
	request_body @import {
		max_size 8192MiB
	}
	@pdf path /api/files/pdf
	request_body @pdf {
		max_size 100MiB
	}
	@pdftext path /api/files/pdf/*/text
	request_body @pdftext {
		max_size 20MiB
	}
	@ops path /api/branches/*/ops
	request_body @ops {
		max_size 2MiB
	}
	@other not path /api/branches/*/ops /api/workspace/import /api/files/pdf /api/files/pdf/*/text
	request_body @other {
		max_size 1MiB
	}

	# The server already sets Content-Security-Policy, nosniff and
	# Referrer-Policy; they are deliberately not repeated here.
	# Access logging is off by default, which keeps invite links
	# (/invite/<token>) out of log files. Do not enable it without need.
}
