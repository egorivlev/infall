# /etc/systemd/system/qoop-backup.service
[Unit]
Description=Infall encrypted database backup
After=network-online.target

[Service]
Type=oneshot
User=qoop
Group=qoop
EnvironmentFile=/etc/qoop/qoop.env
ExecStart=/opt/qoop/backup.sh
UMask=0077

# Needs to read the database and write its -wal/-shm files, and write backups.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/var/lib/qoop /var/backups/qoop
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
