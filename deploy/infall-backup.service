# /etc/systemd/system/infall-backup.service
[Unit]
Description=Infall encrypted backup (a Workspace file)
After=network-online.target

[Service]
Type=oneshot
User=infall
Group=infall
EnvironmentFile=/etc/infall/infall.env
ExecStart=/opt/infall/backup.sh
UMask=0077

# Needs to read the database and write its -wal/-shm files, and write backups.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/var/lib/infall /var/backups/infall
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
