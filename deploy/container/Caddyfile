# The Caddyfile of the container route (deploy/compose.yaml mounts it read-only).
# INFALL_DOMAIN comes from deploy/.env. For a real domain Caddy gets and renews a
# certificate by itself (ports 80 and 443 must reach this machine); for "localhost" it
# uses its own local authority, which curl accepts with -k and browsers warn about.
# Through a Cloudflare Tunnel (compose.cloudflare.yaml) the address is http://INFALL_DOMAIN:
# Cloudflare holds the certificate, and Caddy serves plain HTTP to the tunnel only.
# What every Infall site does, whichever server it is in front of: `import infall server`.
# The one argument is the name of the compose service to pass requests to.
(infall) {
	# WebSockets (live updates) pass through with no extra settings; the Origin header is
	# passed on for the server's own check.
	reverse_proxy {args[0]}:8787

	encode zstd gzip

	# Browsers will refuse plain HTTP for this domain for a year. Not sent for localhost:
	# HSTS ignores ports, and would stop every other http://localhost page in that browser.
	@public not host localhost
	header @public Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Refuse oversized request bodies here, before they reach the server. These are the
	# server's own limits: a Workspace file brought onto an empty server (INFALL_MAX_IMPORT_MB,
	# 8192 by default), a PDF (INFALL_MAX_PDF_MB, 100 by default) — compose.yaml passes the
	# same values to both — 20 MiB for a PDF's text, 2 MiB on the route that carries the
	# captured result of a Run, 1 MiB everywhere else. ("MiB": Caddy's "MB" is 1000-based and
	# a little smaller.)
	@import path /api/workspace/import
	request_body @import {
		max_size {$INFALL_MAX_IMPORT_MB:8192}MiB
	}
	@pdf path /api/files/pdf
	request_body @pdf {
		max_size {$INFALL_MAX_PDF_MB:100}MiB
	}
	@pdftext path /api/files/pdf/*/text
	request_body @pdftext {
		max_size 20MiB
	}
	@ops path /api/branches/*/ops
	request_body @ops {
		max_size 2MiB
	}
	@other not path /api/branches/*/ops /api/workspace/import /api/files/pdf /api/files/pdf/*/text
	request_body @other {
		max_size 1MiB
	}

	# The server sets Content-Security-Policy, nosniff and Referrer-Policy itself.
	# Access logging is off, which keeps invite links (/invite/<token>) out of log files.
}

{$INFALL_CADDY_SITE} {
	import infall server
}

# More Workspaces on this machine, each with its own server and its own address
# (compose.second.yaml puts a file here). No file: nothing more is served.
import /etc/caddy/more/*.caddy
