# deploy/.env — the settings of compose.yaml. Copy this file to .env next to compose.yaml
# and change the first two lines. Plain KEY=value lines; no quotes needed.

# The domain people type, without https://. Its DNS record must point at this machine,
# and ports 80 and 443 must reach it: Caddy then gets the HTTPS certificate by itself.
# "localhost" tries it out on this machine with Caddy's own certificate (curl -k).
INFALL_DOMAIN=infall.example.org

# Which image, and which version of it. "latest" is the newest release: ./update.sh then
# brings the server up to it in one command (README.md, "Upgrade"). A number (0.9.0) keeps
# the server on that version until you change it here; going back to an earlier version
# means setting its number here.
INFALL_IMAGE=ghcr.io/OWNER/infall
INFALL_VERSION=latest

# ---- Backups (README.md, "Back up and restore") ----

# Every day the backup job writes a Workspace file (infall-<time>.infall.gz) into the backups
# volume: the work and the Members' names, but no sign-ins. How many to keep (the oldest
# beyond this are deleted; database copies, below, are counted on their own).
INFALL_BACKUP_KEEP=14
# When the daily Workspace file is made, as HH:MM in UTC.
INFALL_BACKUP_TIME=03:30
# yes: every day also a copy of the whole database (infall-<time>.db.gz), which puts this
# server back with every sign-in, invite and token. About as large again as the files.
#INFALL_BACKUP_DATABASE=no

# ---- Usually left as they are ----

# How many copies of the database made just before an upgrade to keep (in the data volume).
#INFALL_UPGRADE_KEEP=3

# Largest Workspace file that can be brought onto an empty server, in MiB (Caddy and the
# server both get this value). It is received onto the disk, not into memory: while it comes
# in, the data volume needs about three times the file's size free.
#INFALL_MAX_IMPORT_MB=8192

# Largest PDF a Source can carry, in MiB (Caddy and the server both get this value).
#INFALL_MAX_PDF_MB=100

# Seals Members' OpenRouter keys. Leave it out and the server makes one in the data volume
# on first start (secret-key). Set it here (made with:
#   docker compose run --rm server gen-secret-key) to keep it outside the volume.
#INFALL_SECRET_KEY=

# Host ports, if 80 and 443 are taken. Then also set INFALL_PUBLIC_ORIGIN, the exact address
# people type, with the port, e.g. https://localhost:8443. A real domain wants 80 and 443.
#INFALL_HTTP_PORT=80
#INFALL_HTTPS_PORT=443
#INFALL_PUBLIC_ORIGIN=

# Never set INFALL_DEV_ORIGIN or INFALL_ADMIN_PASSWORD here.
