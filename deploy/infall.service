# /etc/systemd/system/infall.service
# Runs the Infall server as an unprivileged user that can write only to /var/lib/infall.
[Unit]
Description=Infall research workspace server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=infall
Group=infall
WorkingDirectory=/opt/infall
EnvironmentFile=/etc/infall/infall.env
ExecStart=/opt/infall/infall-server serve
Restart=on-failure
RestartSec=3
# Give the server time to finish a database write after SIGTERM.
TimeoutStopSec=30
# Files the server creates (the database) are private to the infall user.
UMask=0077

# --- Sandboxing: if the server is ever compromised, this limits the damage. ---
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/var/lib/infall
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
