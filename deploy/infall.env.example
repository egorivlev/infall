# /etc/infall/infall.env   (install with: root:infall, mode 640)
# systemd reads this file as plain KEY=value lines: no quotes, no "export".
# Replace infall.example.org with your own domain.

# Listen address. Keep it on 127.0.0.1 so only Caddy on this machine can reach
# the server; never set 0.0.0.0 here.
INFALL_ADDR=127.0.0.1:8787

# The SQLite file. Must be inside /var/lib/infall (the only writable directory).
INFALL_DB=/var/lib/infall/infall.db

# The exact address people type, with https://, no trailing slash. It turns on
# the Secure cookie flag, is the only Origin accepted for writes, and builds
# invite links. If this is wrong, logins or invite links will fail.
INFALL_PUBLIC_ORIGIN=https://infall.example.org

# Built web UI (the contents of web/dist).
INFALL_WEB_DIR=/opt/infall/web

# Optional: lets Members store their own OpenRouter key (encrypted with this secret) so the
# AI sidebar works in a browser. Leave it out and that path is simply off; the desktop app
# does not need it. Create one with:  infall-server gen-secret-key
# Keep it with your backups' key: without it stored keys cannot be read (Members re-enter them).
#INFALL_SECRET_KEY=

# INFALL_DEV_ORIGIN is for local UI development only. Do NOT set it in production:
# it adds a second Origin that is allowed to make changes. Leave it out.
# (Also do not set INFALL_ADMIN_PASSWORD here: it would keep a password in a file.)

# ---- Used by backup.sh, not by the server ----

# Public key made with `age-keygen` on YOUR laptop (starts with "age1").
# The server holds only this public half, so it cannot decrypt its own backups.
INFALL_BACKUP_AGE_RECIPIENT=YOUR_AGE_PUBLIC_KEY

# Where dated encrypted backups are kept on this machine.
INFALL_BACKUP_DIR=/var/backups/infall

# Local copies older than this many days are deleted.
INFALL_BACKUP_KEEP_DAYS=14

# Each backup is a Workspace file (the work, no sign-ins; README step 9). Set yes to write an
# encrypted copy of the whole database beside it as well (sign-ins and all: this server as it
# was), about as large again.
#INFALL_BACKUP_DATABASE=no

# Where backup.sh finds the server program it makes the Workspace file with.
#INFALL_SERVER_BIN=/opt/infall/infall-server

# Optional off-machine copy. Leave commented out until you have set up rclone
# (see README). Format is "<rclone remote name>:<bucket or folder>".
#INFALL_BACKUP_REMOTE=offsite:infall-backups
# rclone's config file (holds the remote's credentials; root:infall, mode 640).
#RCLONE_CONFIG=/etc/infall/rclone.conf
