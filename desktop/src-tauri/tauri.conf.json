{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sheaf",
  "version": "0.1.0",
  "identifier": "app.qoop.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["setup", "runner-approval", "runner-settings"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
